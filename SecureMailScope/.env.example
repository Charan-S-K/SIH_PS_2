# ==============================================================================
# SecureMailScope — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
# cp .env.example .env

# Application Environment (production, staging, development, testing)
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME=SecureMailScope
VERSION=0.1.0
API_V1_STR=/api/v1
OFFLINE_MODE=true

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securemailscope
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection URL (Container network uses db:5432, local dev uses localhost:5432)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/securemailscope
# Localhost fallback:
# DATABASE_URL=sqlite:///./securemailscope.db

DATABASE_CONNECT_TIMEOUT_SECONDS=5

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000", "http://127.0.0.1:5173"]

# Storage & Cache Volumes
UPLOAD_DIR=/app/uploads
MODELS_CACHE_DIR=/app/models_cache
REPORTS_STORAGE_DIR=/app/reports_storage

# TShark Binary Path (Default uses system PATH)
TSHARK_PATH=/usr/bin/tshark

# Frontend Backend Proxy Target
VITE_BACKEND_URL=http://localhost:8000
