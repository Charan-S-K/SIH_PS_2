# ==============================================================================
# SecureMailScope — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting services:
# cp .env.example .env

# Application Environment (development, testing, staging, production)
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME=SecureMailScope
VERSION=0.1.0
API_V1_STR=/api/v1

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=securemailscope
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Database Connection URL (for container network use db:5432, for localhost use localhost:5432)
# Container default:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/securemailscope
# Localhost bare-metal fallback:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/securemailscope

DATABASE_CONNECT_TIMEOUT_SECONDS=5

# CORS Allowed Origins (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Frontend Backend Proxy Target
VITE_BACKEND_URL=http://localhost:8000
